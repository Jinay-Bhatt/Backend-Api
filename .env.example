# ── Backend Configuration (.env or backend/.env) ─────────────────────
DATABASE_URL="postgresql://username:password@ep-example-pooler.region.neon.tech/neondb?sslmode=require"
REDIS_URL="redis://127.0.0.1:6379"
JWT_SECRET="your-super-secret-jwt-signing-key-min-32-characters"
ENCRYPTION_KEY="your-32-character-encryption-key"
PORT=5000
FRONTEND_URL="http://localhost:3000"

# ── 🇮🇳 BHARATCODE AI (Model: Qwen 3.8 27B) ───────────────────────────
# Base API: https://bharatcode.ai/api/model/v1
# Paste your BharatCode API key below:
AI_PROVIDER="bharatcode"
BHARATCODE_API_KEY="your-bharatcode-api-key-here"
BHARATCODE_BASE_URL="https://bharatcode.ai/api/model/v1"
BHARATCODE_MODEL="qwen-3.8-27b"

# ── Previous Providers (Commented Out As Per Requirement) ────────────
# GROQ_API_KEY=""
# GROQ_MODEL="openai/gpt-oss-120b"
# OLLAMA_URL="http://127.0.0.1:11434"
# OLLAMA_MODEL="llama3"

# ── Frontend Configuration (frontend/.env.local) ──────────────────────
NEXT_PUBLIC_API_URL="http://localhost:5000"
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""
