# =====================================================================
# JBSnap Backend Environment Configuration
# Copy this file to .env and fill in the required credentials
# =====================================================================

# ── REQUIRED: Database & Persistence ─────────────────────────────────
# PostgreSQL connection string (Neon serverless, Supabase, RDS, or local)
DATABASE_URL="postgresql://username:password@ep-example-pooler.region.neon.tech/neondb?sslmode=require"

# Redis connection string for BullMQ queue, locks & cache
REDIS_URL="redis://127.0.0.1:6379"

# ── REQUIRED: Security & Authentication ──────────────────────────────
# Secret key used for Fastify JWT signing & verification (minimum 32 characters)
JWT_SECRET="your-super-secret-jwt-signing-key-min-32-characters"

# AES-256 encryption key for sensitive node credentials and OAuth secrets (32 chars)
ENCRYPTION_KEY="your-32-character-encryption-key"

# ── Server & Networking ──────────────────────────────────────────────
PORT=5000
NODE_ENV="development"
FRONTEND_URL="http://localhost:3000"

# ── 🇮🇳 BHARATCODE AI CONFIGURATION (Hackathon Evaluation) ─────────────
# Primary Provider: BharatCode (Model: Qwen 3.8 27B)
# API Documentation: https://bharatcode.ai/api/model/v1
# Paste your BharatCode API key below:
AI_PROVIDER="bharatcode"
BHARATCODE_API_KEY="your-bharatcode-api-key-here"
BHARATCODE_BASE_URL="https://bharatcode.ai/api/model/v1"
BHARATCODE_MODEL="qwen-3.8-27b"

# ── PREVIOUS AI PROVIDERS (COMMENTED OUT AS PER REQUIREMENT) ──────────
# AI_PROVIDER="auto"
# GROQ_API_KEY=""
# GROQ_MODEL="llama-3.3-70b-versatile"
# OLLAMA_URL="http://127.0.0.1:11434"
# OLLAMA_MODEL="llama3"

# ── Email & SMTP Notifications (Optional) ────────────────────────────
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="no-reply@jbsnap.dev"
